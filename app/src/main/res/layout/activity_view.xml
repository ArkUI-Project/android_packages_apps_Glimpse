<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ViewActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Glimpse.Viewer.IconButton"
                android:contentDescription="@string/viewer_back"
                app:icon="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/mediaDateTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="2026年10月5日" />

                <TextView
                    android:id="@+id/mediaSourceTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="11:23 · Screenshots" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rotateButton"
                style="@style/Widget.Glimpse.Viewer.IconButton"
                android:contentDescription="@string/viewer_rotate"
                app:icon="@drawable/ic_viewer_rotate" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/bottomSheetLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/viewer_action_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/viewer_action_padding"
        android:paddingBottom="@dimen/viewer_action_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/motionPhotoToggleButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/motion_photo_show_video"
            android:visibility="gone"
            app:icon="@drawable/ic_motion_play"
            tools:visibility="visible" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.Glimpse.Viewer.Action"
                    android:contentDescription="@string/file_action_share"
                    android:drawableTop="@drawable/ic_share"
                    android:text="@string/viewer_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/adjustButton"
                    style="@style/Widget.Glimpse.Viewer.Action"
                    android:contentDescription="@string/file_action_edit"
                    android:drawableTop="@drawable/ic_edit"
                    android:text="@string/file_action_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/favoriteButton"
                    style="@style/Widget.Glimpse.Viewer.Action"
                    android:contentDescription="@string/file_action_add_to_favorites"
                    android:drawableTop="@drawable/ic_viewer_favorite_toggle"
                    android:text="@string/viewer_favorite" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteButton"
                    style="@style/Widget.Glimpse.Viewer.Action"
                    android:contentDescription="@string/file_action_move_to_trash"
                    android:drawableTop="@drawable/ic_delete"
                    android:text="@string/viewer_delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moreButton"
                    style="@style/Widget.Glimpse.Viewer.Action"
                    android:contentDescription="@string/viewer_more"
                    android:drawableTop="@drawable/ic_viewer_more"
                    android:text="@string/viewer_more" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
